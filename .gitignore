# ── credentials — never commit ────────────────────────────────────────────
.env
*.key
**/secrets*

# ── derived / bulk data (rebuildable) ─────────────────────────────────────
# NOTE: the corpus itself (data/acceptance_rejected_college_data_verified.csv)
# IS committed — the Outcome Cards cannot be built without it. See data/README.md.
data/*.sqlite
data/ipeds*

# ── generated output ──────────────────────────────────────────────────────
out/
*.pdf
*.state.json
*.plan.json

# ── python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
